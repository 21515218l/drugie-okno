<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Warsztat - Zadanie 2.3"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B">
    <StackPanel Spacing="12" Margin="24">
        <TextBlock Text="Warsztat" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="Okno zbudowane z agentem" HorizontalAlignment="Center" Foreground="#94A3B8" />
        <TextBox Watermark="Wpisz notatkę do warsztatu..." />
        <CheckBox Content="Zadanie sprawdzone w git diff" />
    </StackPanel>
</Window>
